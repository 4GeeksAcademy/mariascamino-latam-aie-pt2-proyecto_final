# Copia este archivo a ".env" (que ya está en .gitignore) y completa los valores.
# Nunca subas el .env real ni pongas API keys directamente en el código.

# --- JWT (login de sesión) ---
JWT_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Recuperación de contraseña ---
# Cuánto dura un link de "olvidé mi contraseña" antes de expirar.
RESET_TOKEN_EXPIRE_MINUTES=30
# Base URL del frontend, usada para armar el link que se manda por correo
# (https://tu-dominio.com en producción).
FRONTEND_URL=http://localhost:3000

# --- SendGrid (envío del correo de recuperación) ---
# Settings -> API Keys en https://app.sendgrid.com
SENDGRID_API_KEY=
# Un remitente verificado en Settings -> Sender Authentication -> Single
# Sender Verification. Sin esto SendGrid rechaza el envío.
SENDGRID_FROM_EMAIL=
