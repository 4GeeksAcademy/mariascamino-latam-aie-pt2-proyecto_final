# Copia este archivo a ".env" (que ya está en .gitignore) y completa los valores.
# Nunca subas el .env real ni pongas API keys directamente en el código.

# --- JWT (login de sesión) ---
JWT_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Recuperación de contraseña ---
# Cuánto dura un link de "olvidé mi contraseña" antes de expirar.
RESET_TOKEN_EXPIRE_MINUTES=30
# Base URL del frontend, usada para armar el link que se manda por correo
# (https://tu-dominio.com en producción).
FRONTEND_URL=http://localhost:3000

# --- SendGrid (envío del correo de recuperación) ---
# Settings -> API Keys en https://app.sendgrid.com
SENDGRID_API_KEY=
# Un remitente verificado en Settings -> Sender Authentication -> Single
# Sender Verification. Sin esto SendGrid rechaza el envío.
SENDGRID_FROM_EMAIL=

# --- Supabase (PostgreSQL) — inventario ---
# Supabase -> Connect -> Direct -> Method: Transaction pooler, Type: URI.
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# --- Telemetría ---
# URL del colector de eventos. Hoy apunta al stub de esta misma API
# (POST /telemetry/events); en la Fase 3 se reemplaza por el colector real
# sin cambiar código. El backoffice usa NEXT_PUBLIC_TELEMETRY_ENDPOINT.
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# Opcional: ruta al contrato de eventos (por defecto docs/telemetry/event-schemas.json
# del monorepo). Útil si la API corre en un contenedor sin la carpeta docs/.
# TELEMETRY_SCHEMA_PATH=/app/docs/telemetry/event-schemas.json
