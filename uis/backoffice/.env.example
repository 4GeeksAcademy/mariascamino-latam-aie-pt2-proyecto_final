# Copy to .env.local (ignored by git) and adjust.

# HealthCore API (FastAPI, services/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Telemetry ---
# Collector that receives the event batches. Today: the Phase 2 stub of the
# API. In Phase 3 it points to the real collector; the backoffice code does
# not change. Without this variable telemetry is disabled (nothing is sent).
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# development | staging | production (envelope field `environment`).
NEXT_PUBLIC_APP_ENV=development
# Short SHA of the deployed commit (envelope `appVersion`, error `app_release`). Optional.
NEXT_PUBLIC_APP_VERSION=
# Share of sessions that report Web Vitals (plan: 0.25). Defaults to 1 in dev.
NEXT_PUBLIC_TELEMETRY_SAMPLE_RATE_VITALS=
