# Copy this file to .env (cp .env.example .env) and adjust the values.
# .env is in .gitignore: never commit it. Put real secrets ONLY in .env.

# ---- UI container ----
APP_MODE=dev
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
# The backoffice server reaches the API by its Docker service name, never localhost.
API_INTERNAL_URL=http://api:8000
# The browser calls the backoffice's own proxy.
NEXT_PUBLIC_API_URL=/api
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# ---- API container ----
API_PORT=8000
# Comma-separated list of origins allowed to call the API directly from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UVICORN_RELOAD=true
WATCHFILES_FORCE_POLLING=true
